<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" 
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.cadenzaflow</groupId>
  <artifactId>cadenzaflow-release-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Cadenzaflow - Release Parent Pom</name>

  <description>
    This pom defines the required plugins and profiles to allow a Cadenzaflow release build.
    Inherit this pom when you want to release your project into the Cadenzaflow nexus and/or maven central.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <version.java>1.7</version.java>
    <version.ejb>3.1</version.ejb>

    <skip.cadenzaflow.release>false</skip.cadenzaflow.release>
    <skip.central.release>false</skip.central.release>

    <nexus.snapshot.repository.id>cadenzaflow-nexus</nexus.snapshot.repository.id>
    <nexus.snapshot.repository>http://18.157.182.187:32265/repository/cadenzaflow-snapshot</nexus.snapshot.repository>

    <nexus.release.repository.id>cadenzaflow-nexus</nexus.release.repository.id>
    <nexus.release.repository>http://18.157.182.187:32265/repository/cadenzaflow-release</nexus.release.repository>

    <nexus.staging.deploy.id>cadenzaflow-nexus</nexus.staging.deploy.id>
    <nexus.staging.deploy.url>http://18.157.182.187:32265/repository/cadenzaflow-release</nexus.staging.deploy.url>

    <gpg.useagent>true</gpg.useagent>

    <plugin.version.clean>2.6</plugin.version.clean>
    <plugin.version.source>2.3</plugin.version.source>
    <plugin.version.compiler>3.1</plugin.version.compiler>
    <plugin.version.jar>2.5</plugin.version.jar>
    <plugin.version.javadoc>2.9.1</plugin.version.javadoc>
    <plugin.version.maven-bundle>2.5.3</plugin.version.maven-bundle>

    <plugin.version.deploy>2.8.2</plugin.version.deploy>
    <plugin.version.assembly>2.4.1</plugin.version.assembly>
    <plugin.version.ejb>2.4</plugin.version.ejb>
    <plugin.version.war>2.4</plugin.version.war>
    <plugin.version.ear>2.9.1</plugin.version.ear>
    <plugin.version.rar>2.4</plugin.version.rar>
    <plugin.version.gpg>1.4</plugin.version.gpg>
    <plugin.version.release>2.5.3</plugin.version.release>
    <plugin.version.nexus-staging>1.6.8</plugin.version.nexus-staging>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <!-- plugin konfigürasyonları (maven-clean, compiler, jar, vb.) buraya aynen gelecek -->
        <!-- ... aynen koruyabilirsin ... -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>${plugin.version.release}</version>
          <configuration>
            <mavenExecutorId>forked-path</mavenExecutorId>
            <useReleaseProfile>false</useReleaseProfile>
            <arguments>${arguments} -Psonatype-oss-release</arguments>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.sonatype.plugins</groupId>
          <artifactId>nexus-staging-maven-plugin</artifactId>
          <version>${plugin.version.nexus-staging}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.sonatype.plugins</groupId>
        <artifactId>nexus-staging-maven-plugin</artifactId>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>default-deploy</id>
            <phase>deploy</phase>
            <goals>
              <goal>deploy</goal>
            </goals>
            <configuration>
              <detectBuildFailures>true</detectBuildFailures>
              <serverId>${nexus.staging.deploy.id}</serverId>
              <nexusUrl>${nexus.staging.deploy.url}</nexusUrl>
              <skipStaging>true</skipStaging>
              <skipNexusStagingDeployMojo>${skip.cadenzaflow.release}</skipNexusStagingDeployMojo>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <distributionManagement>
    <snapshotRepository>
      <id>${nexus.snapshot.repository.id}</id>
      <url>${nexus.snapshot.repository}</url>
    </snapshotRepository>
    <repository>
      <id>${nexus.release.repository.id}</id>
      <url>${nexus.release.repository}</url>
    </repository>
  </distributionManagement>

  <profiles>
    <profile>
      <id>sonatype-oss-release</id>
      <build>
        <plugins>
          <!-- source, javadoc, gpg pluginleri buraya eklenecek -->
          <!-- Aynen koruyabilirsiniz -->
        </plugins>
      </build>
    </profile>
  </profiles>

  <organization>
    <name>Cadenzaflow BPM Community</name>
    <url>http://www.cadenzaflow.com</url>
  </organization>

  <url>http://www.cadenzaflow.org</url>

  <developers>
    <developer>
      <id>cadenzaflow.org</id>
      <name>Cadenzaflow BPM Community</name>
      <organization>cadenzaflow.org</organization>
      <organizationUrl>http://cadenzaflow.org</organizationUrl>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/cadenzaflow/cadenzaflow-release-parent</url>
    <connection>scm:git:git@github.com:cadenzaflow/cadenzaflow-release-parent.git</connection>
    <developerConnection>scm:git:git@github.com:cadenzaflow/cadenzaflow-release-parent.git</developerConnection>
    <!-- tag öğesi kaldırıldı -->
  </scm>

  <issueManagement>
    <system>Jira</system>
    <url>https://app.cadenzaflow.com/jira/browse/CAM/</url>
  </issueManagement>

</project>
